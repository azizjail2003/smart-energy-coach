# Flask Application Configuration
FLASK_DEBUG=0
# Mandatory security key for Flask sessions
SECRET_KEY="secret-key-for-evaluation-2026"
USE_MOCK=false

# Database Configuration
# Default local fallback (Docker Compose automatically overrides this with the MySQL container URL)
DATABASE_URL="sqlite:///smart_energy.db"
# MySQL Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Example for Docker host access: mysql+pymysql://energy_user:energy_password@localhost:3307/smart_energy

# AI Coach Engine API Keys (Optional: if empty, defaults to fallback status)
OPENAI_API_KEY=""
NVIDIA_API_KEY=""
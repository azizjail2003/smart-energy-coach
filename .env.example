# Flask Application Configuration
FLASK_DEBUG=true
SECRET_KEY=replace_with_a_long_random_string_here
USE_MOCK=false

# Database Configuration
# Fallbacks to sqlite:///smart_energy.db if not provided
# MySQL Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_energy

# AI Coach Engine API Keys (Optional: if empty, defaults to fallback status)
OPENAI_API_KEY=your_openai_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here